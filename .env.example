# Copy to .env.local and fill in. Next.js loads .env.local automatically;
# the eval scripts load it explicitly.

# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which intake system prompt the API route uses when a request does not name
# one. v1 and v2 both live in src/lib/prompts/ — the eval harness overrides
# this per run so it can score both.
INTAKE_PROMPT_VERSION=v2

# The model split. Defaults and the reasoning live in src/lib/config.ts; these
# override them. Two constraints the code enforces rather than trusts:
#
#   * the judge must not be the agent's model (self-preference bias), which is
#     asserted in eval/config.test.ts;
#   * every model named here must have a rate in the RATES table in
#     src/lib/config.ts, or the eval refuses to start rather than reporting a
#     cost of $0.00 it cannot compute.
#
# The agent is Haiku 4.5 because that is what a bank running retail onboarding
# at scale would actually deploy on a questionnaire — the realistic case to
# gate, and the harder one. A run can also swap an arm without touching this
# file: `npm run eval -- v1 --agent=claude-sonnet-5`.
PERSONA_MODEL=claude-haiku-4-5
AGENT_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-sonnet-5

# Where the eval harness finds the running app. Start it with `npm run dev`
# first — the harness exits non-zero rather than scoring an unreachable route.
EVAL_BASE_URL=http://localhost:3000

# Personas in flight at once.
EVAL_CONCURRENCY=4
